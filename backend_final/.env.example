# PramaanScan backend configuration.
# Copy to `.env` in this directory and fill in real values.
# NEVER commit the real .env file — only this .env.example.

# --- Database ---
# SQLite by default for local dev; point at Postgres/MySQL etc. in production.
DATABASE_URL=sqlite:///./pramaanscan.db

# --- Auth / JWT ---
# Generate a strong random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_IN_ENV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Signing Key Encryption at Rest ---
# Used to encrypt Ed25519 private keys stored in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not set, keys are stored as plain base64 (demo-only, NOT for production).
KEY_ENCRYPTION_SECRET=CHANGE_ME

# --- Networking ---
# Public URL this backend is reachable at (used in QR code API links).
PUBLIC_BASE_URL=http://127.0.0.1:8000
# URL of the frontend app (used in QR code verification links — QR codes open the frontend, not raw API).
FRONTEND_BASE_URL=http://localhost:5179
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5179,http://127.0.0.1:5179,http://localhost:5178,http://127.0.0.1:5178

# --- ML data root (training/eval only — NOT required for runtime inference) ---
# Only used by PramaanScan_ML/config.py + backend_final/tools/*.
# Safe to leave unset for running the app; only needed if re-training models.
# PRAMAANSCAN_DATA_ROOT=/path/to/PramaanScan_WildDeepfake_Lite/data
