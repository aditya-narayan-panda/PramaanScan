# Base URL of the PramaanScan FastAPI backend (no trailing slash)
# Local dev:
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Production: set this as an Environment Variable in the Vercel dashboard instead
# (Settings -> Environment Variables), pointing at your Render backend URL, e.g.
# VITE_API_BASE_URL=https://pramaanscan-backend.onrender.com/api/v1
