# Image ML service configuration.
# Loaded automatically from a `.env` file in this directory by
# image_ml/config.py (via python-dotenv). All values below are
# optional — sane defaults are baked into config.py.
# Copy to `.env` in this same directory to override any of them.

APP_NAME=Praman Scan
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Paths — resolved relative to this directory (image_ml/) unless absolute.
DATASET_DIR=dataset
MODEL_DIR=saved_models
UPLOAD_TMP_DIR=tmp_uploads
LOG_DIR=logs

# Model file names (must exist inside MODEL_DIR).
SVM_MODEL_FILE=svm.pkl
RF_MODEL_FILE=random_forest.pkl
LOGISTIC_MODEL_FILE=logistic.pkl
SCALER_FILE=feature_scaler.pkl
LABEL_ENCODER_FILE=label_encoder.pkl
METADATA_FILE=training_metadata.json

# Inference thresholds.
AI_THRESHOLD=0.5
DISAGREEMENT_STD_THRESHOLD=0.25
HIGH_CONFIDENCE_MARGIN=0.35
MEDIUM_CONFIDENCE_MARGIN=0.15

# Upload constraints.
MAX_UPLOAD_SIZE_MB=15
